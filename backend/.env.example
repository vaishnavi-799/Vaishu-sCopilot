MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=krishna_ai_assistant
MONGODB_COLLECTION=user_profiles
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
UPLOAD_DIR=uploads
RESUME_MAX_BYTES=10485760
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=800
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_CONTEXT_TOKENS=16000
CHAT_MAX_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW=3600
CHAT_TIMEOUT_SECONDS=45
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1
TEST_MAX_OUTPUT_TOKENS=5000
TEST_MAX_TOPIC_CHARS=300
TEST_MAX_LESSON_CHARS=12000
TEST_ACTIVE_TTL_SECONDS=86400
PASSING_SCORE_PERCENTAGE=70
MIN_TOPIC_QUESTIONS=2
SKILL_LEVEL_DEVELOPING_MIN=50
SKILL_LEVEL_PROFICIENT_MIN=70
SKILL_LEVEL_STRONG_MIN=85
ENABLE_MOCK_QUIZ=false
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
